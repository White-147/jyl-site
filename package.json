{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run db:export && tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:seed": "node scripts/seed-db.mjs",
    "db:export": "node scripts/export-db.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs && node scripts/inline-firstscreen-fonts.mjs",
    "icons:gen": "python scripts/gen_icons.py",
    "contact:encode": "node scripts/encode-contact.mjs --write",
    "resume:watermark": "python scripts/watermark_resume.py",
    "previews:polish": "node scripts/polish-previews.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "subset-font": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
