{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run docs:build",
    "build": "npm run db:export && tsc --noEmit && vite build",
    "prebuild": "npm run docs:build",
    "preview": "vite preview",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:anchors": "node scripts/check-anchors.mjs",
    "docs:verify": "npm run docs:check && npm run docs:anchors",
    "docs:thesis": "node scripts/prepare-thesis.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:export": "node scripts/export-db.mjs",
    "fonts:subset": "npm run docs:build && node scripts/subset-fonts.mjs && node scripts/inline-firstscreen-fonts.mjs",
    "icons:gen": "python scripts/gen_icons.py",
    "contact:encode": "node scripts/encode-contact.mjs --write",
    "resume:watermark": "python scripts/watermark_resume.py",
    "previews:polish": "node scripts/polish-previews.mjs",
    "previews:icons": "pwsh -File scripts/gen-preview-icons.ps1",
    "previews:sync": "node scripts/sync-preview.mjs",
    "images:optimize": "python scripts/optimize_images.py",
    "attachments:compress": "python scripts/compress_attachments.py",
    "check:controls": "node scripts/check-controls.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "start:all": "pwsh -File scripts/start-all.ps1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "subset-font": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
